# ai& (OpenAI-compatible). Never commit the real key.
AIAND_API_KEY=
AIAND_BASE_URL=https://api.aiand.com/v1

# Model tiers. Run `npm run models` to see what your key can use.
MODEL_FAST=deepseek-ai/deepseek-v4.1-flash-1017
MODEL_STRONG=deepseek-ai/deepseek-v4-pro
# Reasoning effort per tier (must be one the model lists; blank = model default)
REASONING_FAST=low
REASONING_STRONG=high
# Effort for plain extraction (listing a report's claims) on the strong model
REASONING_LIGHT=none

# Pipeline rules
SWEEP_MINUTES=5
MIN_OUTLETS=2
WAITING_TTL_HOURS=12
# Fewest corroborated claims a fact sheet needs before a story is written
MIN_CLAIMS=3
# Cost/time guard: most events taken through fact-check -> press per sweep
MAX_EVENTS_PER_SWEEP=40

# Daily spend cap in USD. When today's model cost (midnight to midnight IST)
# reaches it, the worker makes no more model calls until the next IST day.
DAILY_BUDGET_USD=5

# Password for the newsroom console at /admin. Leave empty to disable it.
ADMIN_PASSWORD=

# Polite fetching
BOT_USER_AGENT=TheSecondSourceBot/0.1 (news corroboration; local development)
FETCH_DELAY_MS=1000

# SQLite file shared by the app and the worker
DATABASE_PATH=./data/second-source.db
